# 拾光集 · 环境变量配置示例
# 复制为 .env 并修改为你的实际路径

# 数据库路径（默认: 项目目录/media_library.db）
DB_PATH=/data/media_library.db

# 媒体根目录（默认: 项目目录/media）
MEDIA_ROOT=/path/to/your/media

# 队列文件（默认: MEDIA_ROOT/_queue.json）
# QUEUE_FILE=

# Worker 相关
WORKER_PYTHON=python3
INGEST_DIR=/path/to/shiguangji

# XHS-Downloader（小红书无水印下载，可选）
XHS_PYTHON=/path/to/xhs-downloader/.venv/bin/python
XHS_DIR=/path/to/xhs-downloader
XHS_COOKIE_FILE=/path/to/xhs_cookie.txt

# 轻解析服务（抖音/微博解析，需自建）
LITE_PARSER_URL=http://localhost:8086

# 代理（X/Twitter 下载用）
PROXY_URL=http://127.0.0.1:20172

# Bark 推送（可选）
BARK_URL=

# 分页大小
ITEMS_PER_PAGE=40

# 日志
LOG_DIR=/path/to/logs
LOG_LEVEL=INFO
